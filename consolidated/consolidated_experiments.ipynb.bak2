      "\u001b[36mFile \u001b[39m\u001b[32m/opt/miniconda3/envs/AITRAINING/lib/python3.11/site-packages/xgboost/data.py:409\u001b[39m, in \u001b[36mpandas_feature_info\u001b[39m\u001b[34m(data, meta, feature_names, feature_types, enable_categorical)\u001b[39m\n\u001b[32m    407\u001b[39m             new_feature_types.append(_pandas_dtype_mapper[dtype.name])\n\u001b[32m    408\u001b[39m         \u001b[38;5;28;01mexcept\u001b[39;00m \u001b[38;5;167;01mKeyError\u001b[39;00m:\n\u001b[32m--> \u001b[39m\u001b[32m409\u001b[39m             \u001b[43m_invalid_dataframe_dtype\u001b[49m\u001b[43m(\u001b[49m\u001b[43mdata\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    411\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m feature_types \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m \u001b[38;5;129;01mand\u001b[39;00m meta \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m:\n\u001b[32m    412\u001b[39m     feature_types = new_feature_types\n",
      "\u001b[36mFile \u001b[39m\u001b[32m/opt/miniconda3/envs/AITRAINING/lib/python3.11/site-packages/xgboost/data.py:372\u001b[39m, in \u001b[36m_invalid_dataframe_dtype\u001b[39m\u001b[34m(data)\u001b[39m\n\u001b[32m    370\u001b[39m type_err = \u001b[33m\"\u001b[39m\u001b[33mDataFrame.dtypes for data must be int, float, bool or category.\u001b[39m\u001b[33m\"\u001b[39m\n\u001b[32m    371\u001b[39m msg = \u001b[33mf\u001b[39m\u001b[33m\"\"\"\u001b[39m\u001b[38;5;132;01m{\u001b[39;00mtype_err\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m \u001b[39m\u001b[38;5;132;01m{\u001b[39;00m_ENABLE_CAT_ERR\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m \u001b[39m\u001b[38;5;132;01m{\u001b[39;00merr\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m\"\"\"\u001b[39m\n\u001b[32m--> \u001b[39m\u001b[32m372\u001b[39m \u001b[38;5;28;01mraise\u001b[39;00m \u001b[38;5;167;01mValueError\u001b[39;00m(msg)\n",
      "\u001b[31mValueError\u001b[39m: DataFrame.dtypes for data must be int, float, bool or category. When categorical type is supplied, the experimental DMatrix parameter`enable_categorical` must be set to `True`.  Invalid columns:region_type: object, city_type: object"
     ]
    }
   ],
   "source": [
    "# =====================================================================\n",
    "# §10  EXECUTION: Run All Experiments\n",
    "# =====================================================================\n",
    "\n",
    "all_results = []  # Accumulate all result DataFrames\n",
    "all_artifacts = {}  # Store artifacts for later visualization\n",
    "\n",
    "SPLITS = ['Random(70/15/15)', 'GroupSplit(grid_id)']\n",
    "\n",
    "# --------------------------------------------------------\n",
    "# Experiment 1: Contrastive Learning (XGB + RF)\n",
    "# --------------------------------------------------------\n",
    "print('='*70)\n",
    "print('EXPERIMENT: Contrastive Learning (XGB + RF)')\n",
    "print('='*70)\n",
    "\n",
    "for split in SPLITS:\n",
    "    for target in TARGET_COLS:\n",
    "        # XGB contrastive\n",
    "        df_xgb = run_xgb_contrastive_experiment(split, target)\n",
    "        all_results.append(df_xgb)\n",
    "        \n",
    "        # RF contrastive\n",
    "        df_rf = run_rf_contrastive_experiment(split, target)\n",
    "        all_results.append(df_rf)\n",
    "\n",
    "# --------------------------------------------------------\n",
    "# Experiment 2: Mixture of Experts\n",
    "# --------------------------------------------------------\n",
    "print('\\n' + '='*70)\n",
    "print('EXPERIMENT: Mixture of Experts (MoE)')\n",
    "print('='*70)\n",
    "\n",
    "for split in SPLITS:\n",
    "    for target in TARGET_COLS:\n",
    "        df_moe, moe_out = run_moe_experiment(split, target)\n",
    "        all_results.append(df_moe)\n",
    "        all_artifacts[f'MoE_{split}_{target}'] = moe_out\n",
    "\n",
    "# --------------------------------------------------------\n",
    "# Experiment 3: Multi-Baselines (7 models × 3 variants)\n",
    "# --------------------------------------------------------\n",
    "print('\\n' + '='*70)\n",
    "print('EXPERIMENT: Multi-Baselines with Affine Calibration')\n",
    "print('='*70)\n",
    "\n",
    "# Use 0.6/0.4 weights for RMSE/CL mix (from notebooks 5, 7)\n",
    "MB_WEIGHTS = (.6, .4)\n",
    "\n",
    "for split in SPLITS:\n",
    "    if split == 'Random(70/15/15)':\n",
    "        tr, va, te = make_random_split(df)\n",
    "    else:\n",
    "        tr, va, te = make_group_split_by_grid(df)\n",
    "    \n",
    "    for target in TARGET_COLS:\n",
    "        print(f'\\n--- Multi-Baselines [{split}, {target}] ---')\n",
    "        print_splits(df, tr, va, te, target)\n",
    "        \n",
    "        rows_mb, arts_mb = run_all_multibaselines(\n",
    "            df, tr, va, te, target,\n",
    "            rmse_weight=MB_WEIGHTS[0], cl_weight=MB_WEIGHTS[1])\n",
    "        \n",
    "        df_mb = pd.DataFrame(rows_mb)\n",
    "        df_mb['Split'] = split\n",
    "        all_results.append(df_mb)\n",
    "        all_artifacts[f'MB_{split}_{target}'] = arts_mb\n",
    "\n",
    "# --------------------------------------------------------\n",
    "# Experiment 4: Weight Sweep\n",
    "# --------------------------------------------------------\n",
    "print('\\n' + '='*70)\n",
    "print('EXPERIMENT: Mix-Weight Sweep')\n",
    "print('='*70)\n",
    "\n",
    "sweep_split = 'GroupSplit(grid_id)'\n",
    "sweep_target = 'dWorldPop'\n",
    "sweep_weights = np.arange(0., 1.01, .05)  # 21 points\n",
    "\n",
    "df_sweep_raw, df_sweep_agg = run_weight_sweep(\n",
    "    sweep_split, sweep_target, weights=sweep_weights, verbose=True)\n",
    "\n",
    "# --------------------------------------------------------\n",
    "# Combine All Results\n",
    "# --------------------------------------------------------\n",
    "results_df = pd.concat(all_results, ignore_index=True)\n",
    "print(f'\\nTotal result rows: {len(results_df)}')\n",
    "display(results_df.head(10))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 11: Results Saving\n",
    "\n",
    "Save results to Excel and CSV files."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================================\n",
    "# §11  SAVE RESULTS\n",
    "# =====================================================================\n",
    "\n",
    "pd.set_option('display.max_rows', 5000)\n",
    "pd.set_option('display.max_columns', 200)\n",
    "\n",
    "RESULT1 = results_df.copy()\n",
    "\n",
    "# Pivot table for easy comparison\n",
    "metric_cols = [c for c in RESULT1.columns\n",
    "               if c.startswith('All_') or c.startswith('Tail_') or c == 'Tail_Rate']\n",
    "RESULT2 = RESULT1.pivot_table(\n",
    "    index=['Split', 'Target'], columns='Model', values=metric_cols)\n",
    "\n",
    "display(RESULT1.head(20))\n",
    "print('\\nPivot table:')\n",
    "display(RESULT2.head(10))\n",
    "\n",
    "# Save to Excel\n",
    "out_xlsx = os.path.join(OUTDIR, 'results_tail_tables.xlsx')\n",
    "RESULT2_flat = RESULT2.copy()\n",
    "RESULT2_flat.columns = [f'{m}__{md}' for m, md in RESULT2_flat.columns.to_list()]\n",
    "RESULT2_flat = RESULT2_flat.reset_index()\n",
    "\n",
    "with pd.ExcelWriter(out_xlsx, engine='openpyxl') as writer:\n",
    "    RESULT1.to_excel(writer, sheet_name='RESULT1_long', index=False)\n",
    "    RESULT2_flat.to_excel(writer, sheet_name='RESULT2_pivot', index=False)\n",
    "print(f'Saved: {out_xlsx}')\n",
    "\n",
    "# Save CSV\n",
    "out_csv = os.path.join(OUTDIR, 'results_consolidated.csv')\n",
    "RESULT1.to_csv(out_csv, index=False)\n",
    "print(f'Saved: {out_csv}')\n",
    "\n",
    "# Save sweep results\n",
    "if df_sweep_raw is not None:\n",
    "    sweep_raw_path = os.path.join(OUTDIR, 'sweep_raw.csv')\n",
    "    sweep_agg_path = os.path.join(OUTDIR, 'sweep_agg.csv')\n",
    "    df_sweep_raw.to_csv(sweep_raw_path, index=False)\n",
    "    df_sweep_agg.to_csv(sweep_agg_path, index=False)\n",
    "    print(f'Saved sweep: {sweep_raw_path}, {sweep_agg_path}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 12: Visualization\n",
    "\n",
    "Shared plotting utilities for all experiments."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================================\n",
    "# §12  VISUALIZATION UTILITIES\n",
    "# =====================================================================\n",
    "\n",
    "plt.rcParams.update({\n",
    "    'figure.figsize': (6.5, 4.5),\n",
    "    'axes.grid': True,\n",
    "    'grid.alpha': 0.2,\n",
    "    'axes.titlesize': 12,\n",
    "    'axes.labelsize': 11,\n",
    "})\n",
    "\n",
    "def annot_metrics(ax, y_true, y_pred):\n",
    "    \"\"\"Add RMSE/MAE/R2 annotation to a subplot.\"\"\"\n",
    "    m = reg_metrics(y_true, y_pred)\n",
    "    txt = f\"RMSE={m['RMSE']:.3f}\\nMAE={m['MAE']:.3f}\\nR2={m['R2']:.3f}\"\n",
    "    ax.text(0.02, 0.98, txt, transform=ax.transAxes, va='top', ha='left',\n",
    "            fontsize=9, bbox=dict(boxstyle='round', facecolor='white',\n",
    "                                  alpha=0.85, linewidth=0.5))\n",
    "\n",
    "\n",
    "def plot_pred_vs_true(y_true, y_pred, q05=None, q95=None, title='Pred vs True'):\n",
    "    \"\"\"Scatter plot of predicted vs true values with tail highlighting.\"\"\"\n",
    "    y_true, y_pred = np.asarray(y_true), np.asarray(y_pred)\n",
    "    fig, ax = plt.subplots()\n",
    "    \n",
    "    if q05 is not None and q95 is not None:\n",
    "        m = tail_mask(y_true, q05, q95)\n",
    "        if (~m).sum() > 0:\n",
    "            ax.hexbin(y_true[~m], y_pred[~m], gridsize=45, mincnt=1, linewidths=0.)\n",
    "        if m.sum() > 0:\n",
    "            ax.scatter(y_true[m], y_pred[m], s=18, marker='x', alpha=.9, label='Tail')\n",
    "    else:\n",
    "        ax.scatter(y_true, y_pred, s=8, alpha=.5)\n",
    "    \n",
    "    lims = [min(y_true.min(), y_pred.min()), max(y_true.max(), y_pred.max())]\n",
    "    ax.plot(lims, lims, '--', linewidth=1, alpha=.8)\n",
    "    ax.set_xlabel('True'); ax.set_ylabel('Pred'); ax.set_title(title)\n",
    "    annot_metrics(ax, y_true, y_pred)\n",
    "    if q05 is not None:\n",
    "        ax.legend(loc='lower right', framealpha=.8)\n",
    "    fig.tight_layout()\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_residual_hist(y_true, y_pred, title='Residual distribution'):\n",
    "    \"\"\"Histogram of residuals.\"\"\"\n",
    "    res = np.asarray(y_pred) - np.asarray(y_true)\n",
    "    fig, ax = plt.subplots()\n",
    "    ax.hist(res, bins=60, alpha=.8)\n",
    "    ax.set_title(title); ax.set_xlabel('Residual (pred - true)')\n",
    "    ax.set_ylabel('Count')\n",
    "    fig.tight_layout()\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_pi_diag(art, title='p_i distribution'):\n",
    "    \"\"\"Histogram of contrastive p_i values.\"\"\"\n",
    "    if art.diag_test is None or len(art.diag_test) == 0:\n",
    "        return None\n",
    "    fig, ax = plt.subplots()\n",
    "    ax.hist(np.asarray(art.diag_test), bins=50, alpha=.85)\n",
    "    ax.set_title(title); ax.set_xlabel('p_i'); ax.set_ylabel('Count')\n",
    "    fig.tight_layout()\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_triplet(arts, base_name, split_name, target):\n",
    "    \"\"\"\n",
    "    Create a 3-panel figure comparing Base / CL / RMSE_CL for one model.\n",
    "    \"\"\"\n",
    "    keys = [base_name, f'{base_name}_CL', f'{base_name}_RMSE_CL']\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(15.8, 4.5))\n",
    "    colors = ['#5183C8', '#CA7D7D', '#12171D']\n",
    "    \n",
    "    for ax, k in zip(axes, keys):\n",
    "        if k not in arts:\n",
    "            ax.set_title(f'{k} (N/A)')\n",
    "            continue\n",
    "        art = arts[k]\n",
    "        y_true, y_pred = art.y_true, art.y_pred\n",
    "        m = tail_mask(y_true, art.tail_q05, art.tail_q95)\n",
    "        \n",
    "        ax.scatter(y_true[~m], y_pred[~m], s=16, marker='x', alpha=.4,\n",
    "                   linewidths=.8, rasterized=True, c=colors[0])\n",
    "        ax.scatter(y_true[m], y_pred[m], s=22, marker='x', alpha=.6,\n",
    "                   linewidths=1.2, c=colors[1])\n",
    "        \n",
    "        lims = [min(y_true.min(), y_pred.min()), max(y_true.max(), y_pred.max())]\n",
    "        ax.plot(lims, lims, '--', linewidth=1, alpha=.8, c=colors[2])\n",
    "        ax.set_title(k); ax.set_xlabel('True'); ax.set_ylabel('Pred')\n",
    "        annot_metrics(ax, y_true, y_pred)\n",
    "    \n",
    "    fig.suptitle(f'[{split_name}] {target} - {base_name}', y=1.02, fontsize=13)\n",
    "    fig.tight_layout()\n",
    "    return fig\n",
    "\n",
    "\n",
    "def save_fig(fig, name):\n",
    "    \"\"\"Save a figure to the output directory.\"\"\"\n",
    "    path = os.path.join(FIGDIR, safe_filename(name))\n",
    "    fig.savefig(path, dpi=400, bbox_inches='tight')\n",
    "    plt.close(fig)\n",
    "    return path\n",
    "\n",
    "\n",
    "def plot_weight_sweep(df_agg, metric='R2', split_name='', target=''):\n",
    "    \"\"\"\n",
    "    Plot mean +/- std of a metric vs w_rmse across all models.\n",
    "    \"\"\"\n",
    "    assert metric in ('R2', 'RMSE')\n",
    "    \n",
    "    x = df_agg['w_rmse'].values\n",
    "    \n",
    "    if metric == 'R2':\n",
    "        y_all, s_all = df_agg['mean_R2_all'].values, df_agg['std_R2_all'].values\n",
    "        y_tail, s_tail = df_agg['mean_R2_tail'].values, df_agg['std_R2_tail'].values\n",
    "        ylabel = '$R^2$ (higher is better)'\n",
    "    else:\n",
    "        y_all, s_all = df_agg['mean_RMSE_all'].values, df_agg['std_RMSE_all'].values\n",
    "        y_tail, s_tail = df_agg['mean_RMSE_tail'].values, df_agg['std_RMSE_tail'].values\n",
    "        ylabel = 'RMSE (lower is better)'\n",
    "    \n",
    "    fig, ax = plt.subplots(figsize=(6.4, 4.2), dpi=200)\n",
    "    ax.plot(x, y_all, 'o-', linewidth=1.6, markersize=3.5, label='All (mean)', alpha=.8)\n",
    "    ax.fill_between(x, y_all-s_all, y_all+s_all, alpha=.12)\n",
    "    ax.plot(x, y_tail, 's-', linewidth=1.6, markersize=3.5, label='Tail (mean)', alpha=.8)\n",
    "    ax.fill_between(x, y_tail-s_tail, y_tail+s_tail, alpha=.12)\n",
    "    ax.set_xlabel('RMSE weight $w_{rmse}$ (CL weight $1-w_{rmse}$)', fontsize=11)\n",
    "    ax.set_ylabel(ylabel, fontsize=11)\n",
    "    ax.grid(True, alpha=.25, linestyle='--')\n",
    "    ax.legend(frameon=False, loc='best', fontsize=10)\n",
    "    ax.set_title(f'[{split_name}] {target}: {metric} vs Mix weights', fontsize=12)\n",
    "    fig.tight_layout()\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_per_model_sweep(df_raw, split_name, target):\n",
    "    \"\"\"\n",
    "    Create a 2x2 compound figure with per-model RMSE/R2 curves\n",
    "    for All and Tail subsets.\n",
    "    \"\"\"\n",
    "    import seaborn as sns\n",
    "    sns.set_style('whitegrid', {'grid.alpha': 0.2})\n",
    "    \n",
    "    PALETTE = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728', '#9467bd', '#8c564b']\n",
    "    MODEL_ORDER = ['Ridge', 'ElasticNet', 'SVR', 'RandomForest', 'ExtraTrees', 'MLP']\n",
    "    COLORS = {m: PALETTE[i] for i, m in enumerate(MODEL_ORDER)}\n",
    "    \n",
    "    d = df_raw[(df_raw['split'] == split_name) & (df_raw['target'] == target)].copy()\n",
    "    \n",
    "    fig, axes = plt.subplots(2, 2, figsize=(13, 10.5), dpi=180)\n",
    "    configs = [\n",
    "        (axes[0,0], 'RMSE_all', 'RMSE (All)', '(a)'),\n",
    "        (axes[0,1], 'R2_all', 'R2 (All)', '(b)'),\n",
    "        (axes[1,0], 'RMSE_tail', 'RMSE (Tail)', '(c)'),\n",
    "        (axes[1,1], 'R2_tail', 'R2 (Tail)', '(d)'),\n",
    "    ]\n",
    "    \n",
    "    for ax, ycol, title, panel in configs:\n",
    "        for m in MODEL_ORDER:\n",
    "            dm = d[d['model'] == m].sort_values('w_rmse')\n",
    "            if dm.empty:\n",
    "                continue\n",
    "            ax.plot(dm['w_rmse'], dm[ycol], linewidth=2.6,\n",
    "                    color=COLORS[m], marker='o', markersize=5.5,\n",
    "                    label=m, alpha=.85, markeredgewidth=.5,\n",
    "                    markeredgecolor='white')\n",
    "        ax.set_title(f'$\\\\mathbf{{{panel}}}$  {title}', fontsize=14, loc='left')\n",
    "        ax.set_xlabel(r'RMSE weight $w_{\\\\rm rmse}$' if 'Tail' in title else '')\n",
    "        ax.set_ylabel(panel[-1] if 'R2' in ycol else 'RMSE')\n",
    "        ax.grid(True, alpha=.25)\n",
    "        ax.spines['top'].set_visible(False)\n",
    "        ax.spines['right'].set_visible(False)\n",
    "    \n",
    "    handles = [plt.Line2D([0], [0], color=COLORS[m], lw=2.6, marker='o',\n",
    "                          markersize=5.5, label=m, alpha=.85,\n",
    "                          markeredgewidth=.5, markeredgecolor='white')\n",
    "               for m in MODEL_ORDER]\n",
    "    fig.legend(handles=handles, loc='lower center', ncol=6, frameon=False,\n",
    "               fontsize=12, bbox_to_anchor=(.5, 0.055))\n",
    "    fig.subplots_adjust(bottom=.165, hspace=.28, wspace=.28,\n",
    "                        top=.935, left=.09, right=.96)\n",
    "    return fig"
   ]
  },
