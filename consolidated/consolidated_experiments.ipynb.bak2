    "# =====================================================================\n",
    "# §2  DATA LOADING & PREPROCESSING\n",
    "# =====================================================================\n",
    "\n",
    "DATA_PATH = 'grids_set_4_HQ.xlsx'\n",
    "\n",
    "def load_data(data_path: str = DATA_PATH) -> pd.DataFrame:\n",
    "    paths_to_check = [data_path, '/mnt/data/grids_set_4_HQ.xlsx']\n",
    "    for p in paths_to_check:\n",
    "        if os.path.exists(p):\n",
    "            df = pd.read_excel(p)\n",
    "            df.columns = df.columns.str.strip()\n",
    "            return df\n",
    "    raise FileNotFoundError(f'Data not found. Checked: {paths_to_check}')\n",
    "\n",
    "def preprocess_data(df: pd.DataFrame, jitter: bool = True) -> pd.DataFrame:\n",
    "    # COVID intensity map\n",
    "    covid_map = {2015:0., 2016:0., 2017:0., 2018:0., 2019:.05,\n",
    "                 2020:.8, 2021:1., 2022:.6, 2023:.4, 2024:.2}\n",
    "    df = df.dropna(subset=['year']).copy()\n",
    "    df['year'] = df['year'].astype(int)\n",
    "    df['covid_intensity'] = df['year'].map(covid_map).fillna(0.0)\n",
    "    if jitter:\n",
    "        use_cols = [c for c in df.columns if c.endswith('_use')] \\\n",
    "                   + ['VIIRS_last_year', 'WorldPop_last_year']\n",
    "        use_cols = [c for c in use_cols if c in df.columns]\n",
    "        if use_cols:\n",
    "            df[use_cols] += np.random.uniform(-.01, .01, size=(len(df), len(use_cols)))\n",
    "    return df\n",
    "\n",
    "# Column definitions\n",
    "NUMERIC_COLS = ['mot_use','tru_use','pri_use','sec_use','ter_use','urb_use',\n",
    "                'VIIRS_last_year','WorldPop_last_year','covid_intensity']\n",
    "CATEGORICAL_COLS = ['region_type','city_type']\n",
    "FEATURE_COLS = NUMERIC_COLS + CATEGORICAL_COLS\n",
    "TARGET_COLS = ['dVIIRS', 'dWorldPop']\n",
    "\n",
    "def build_preprocessor(nf=None, cf=None):\n",
    "    nf = nf or NUMERIC_COLS; cf = cf or CATEGORICAL_COLS\n",
    "    try:\n",
    "        ohe = OneHotEncoder(handle_unknown='ignore', sparse_output=False)\n",
    "    except TypeError:\n",
    "        ohe = OneHotEncoder(handle_unknown='ignore', sparse=False)\n",
    "    return ColumnTransformer([\n",
    "        ('num', Pipeline([('imp', SimpleImputer(strategy='median')),\n",
    "                          ('scl', StandardScaler())]), nf),\n",
    "        ('cat', Pipeline([('imp', SimpleImputer(strategy='constant',\n",
    "                          fill_value='Unknown')), ('ohe', ohe)]), cf)\n",
    "    ], remainder='drop', verbose_feature_names_out=False)\n",
    "\n",
    "# Load data\n",
    "df_raw = load_data(DATA_PATH)\n",
    "print(f'Shape: {df_raw.shape}')\n",
    "df = preprocess_data(df_raw)\n",
    "display(df.head(3))\n",
    "\n",
    "required = FEATURE_COLS + TARGET_COLS + ['grid_id','year']\n",
    "missing = [c for c in required if c not in df.columns]\n",
    "assert not missing, f'Missing: {missing}'\n",
    "\n",
    "print(f'Features ({len(FEATURE_COLS)}): {FEATURE_COLS}')\n",
    "print(f'Targets: {TARGET_COLS}')\n",
    "preprocessor = build_preprocessor()\n",
    "display(df[FEATURE_COLS + TARGET_COLS].isna().mean().to_frame('missing_ratio').head(12))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Utility Functions\n",
    "\n",
    "Shared functions for data splitting, regression metrics, tail evaluation, and contrastive learning losses."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================================\n",
    "# §3  UTILITY FUNCTIONS\n",
    "# =====================================================================\n",
    "\n",
    "def make_random_split(df_in, test_size=.15, val_size=.15, seed=SEED):\n",
    "    idx = np.arange(len(df_in))\n",
    "    tr, tmp = train_test_split(idx, test_size=test_size+val_size,\n",
    "                                random_state=seed, shuffle=True)\n",
    "    rel = test_size / (test_size + val_size)\n",
    "    va, te = train_test_split(tmp, test_size=rel,\n",
    "                              random_state=seed, shuffle=True)\n",
    "    return tr, va, te\n",
    "\n",
    "def make_group_split_by_grid(df_in, group_col='grid_id',\n",
    "                              test_size=.15, val_size=.15, seed=SEED):\n",
    "    groups = df_in[group_col].astype(str).values\n",
    "    gss = GroupShuffleSplit(n_splits=1, test_size=test_size, random_state=seed)\n",
    "    tv_idx, te_idx = next(gss.split(np.arange(len(df_in)), groups=groups))\n",
    "    gss2 = GroupShuffleSplit(n_splits=1,\n",
    "        test_size=val_size/(1-test_size), random_state=seed)\n",
    "    tr_rel, va_rel = next(gss2.split(tv_idx, groups=groups[tv_idx]))\n",
    "    return tv_idx[tr_rel], tv_idx[va_rel], te_idx\n",
    "\n",
    "def filter_missing(df_in, idx, target):\n",
    "    mask = df_in.iloc[idx][target].notna().values\n",
    "    return idx[mask]\n",
    "\n",
    "def print_splits(df_in, tr, va, te, target):\n",
    "    n = [df_in.iloc[s][target].notna().sum() for s in (tr, va, te)]\n",
    "    print(f'[{target}] train/val/test: {n[0]}/{n[1]}/{n[2]}')\n",
    "\n",
    "# Tail & metrics\n",
    "def tail_thresholds(y, ql=.05, qh=.95):\n",
    "    return float(np.quantile(y, ql)), float(np.quantile(y, qh))\n",
    "\n",
    "def tail_mask(y, q05, q95):\n",
    "    return (y <= q05) | (y >= q95)\n",
    "\n",
    "def reg_metrics(y_true, y_pred):\n",
    "    ae = np.abs(y_true - y_pred)\n",
    "    return {'MAE': float(mean_absolute_error(y_true, y_pred)),\n",
    "            'RMSE': float(np.sqrt(mean_squared_error(y_true, y_pred))),\n",
    "            'R2': float(r2_score(y_true, y_pred)),\n",
    "            'AbsErr_P95': float(np.quantile(ae, .95)),\n",
    "            'AbsErr_P99': float(np.quantile(ae, .99))}\n",
    "\n",
    "def eval_tail(y_true, y_pred, q05, q95):\n",
    "    out = {f'All_{k}':v for k,v in reg_metrics(y_true, y_pred).items()}\n",
    "    m = tail_mask(y_true, q05, q95)\n",
    "    out['Tail_Rate'] = float(m.mean())\n",
    "    if m.sum() > 0:\n",
    "        out.update({f'Tail_{k}':v for k,v in reg_metrics(y_true[m], y_pred[m]).items()})\n",
    "    else:\n",
    "        out.update({f'Tail_{k}':np.nan for k in ['MAE','RMSE','R2','AbsErr_P95','AbsErr_P99']})\n",
    "    return out\n",
    "\n",
    "# Temperature\n",
    "def compute_temp(y, factor=CL_TEMP_FACTOR):\n",
    "    return max(float(np.std(y)) * factor, 1e-3)\n",
    "\n",
    "# =====================================================================\n",
    "# §3b  CONTRASTIVE LEARNING LOSSES (standalone functions)\n",
    "# =====================================================================\n",
    "\n",
    "def cl_loss_and_p(y_pred, y_true, T):\n",
    "    y_pred = np.asarray(y_pred, dtype=float)\n",
    "    y_true = np.asarray(y_true, dtype=float)\n",
    "    B = len(y_true)\n",
    "    if B == 0:\n",
    "        return np.nan, np.array([])\n",
    "    T = float(max(T, 1e-6))\n",
    "    D = np.abs(y_pred[:, None] - y_true[None, :])\n",
    "    logits = -D / T\n",
    "    logits -= np.max(logits, axis=1, keepdims=True)\n",
    "    exp_l = np.exp(logits)\n",
    "    denom = np.sum(exp_l, axis=1)\n",
    "    p = np.diag(exp_l) / np.maximum(denom, CL_EPS)\n",
    "    return float(np.mean(-np.log(np.maximum(p, CL_EPS)))), p\n",
    "\n",
    "def cl_grad(y_pred, y_true, T):\n",
    "    y_pred = np.asarray(y_pred, dtype=float)\n",
    "    y_true = np.asarray(y_true, dtype=float)\n",
    "    B = len(y_true)\n",
    "    if B == 0:\n",
    "        return np.array([])\n",
    "    T = float(max(T, 1e-6))\n",
    "    D = np.abs(y_pred[:, None] - y_true[None, :])\n",
    "    logits = -D / T\n",
    "    logits -= np.max(logits, axis=1, keepdims=True)\n",
    "    P = np.exp(logits) / np.maximum(np.sum(np.exp(logits), axis=1, keepdims=True), CL_EPS)\n",
    "    S = np.sign(y_pred[:, None] - y_true[None, :])\n",
    "    grad = (np.diag(S) - np.sum(P * S, axis=1)) / T / float(B)\n",
    "    return grad\n",
    "\n",
    "def rmse_grad(y_pred, y_true):\n",
    "    y_pred = np.asarray(y_pred, dtype=float)\n",
    "    y_true = np.asarray(y_true, dtype=float)\n",
    "    B = len(y_true)\n",
    "    if B == 0:\n",
    "        return np.nan, np.array([])\n",
    "    err = y_pred - y_true\n",
    "    mse = float(np.mean(err*err))\n",
    "    rmse = float(np.sqrt(max(mse, 0.)))\n",
    "    return rmse, (err / max(rmse, 1e-6)) / float(B)\n",
    "\n",
    "def approx_pi(y_pred, y_true, T, bs=256, seed=SEED):\n",
    "    rng = np.random.default_rng(seed)\n",
    "    n = len(y_true)\n",
    "    if n == 0:\n",
    "        return np.array([])\n",
    "    order = rng.permutation(n)\n",
    "    ps = []\n",
    "    for s in range(0, n, bs):\n",
    "        b = order[s:s+bs]\n",
    "        _, p = cl_loss_and_p(y_pred[b], y_true[b], T)\n",
    "        ps.append(p)\n",
    "    return np.concatenate(ps)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 4: Affine Calibrator\n",
    "\n",
    "Trains a lightweight affine layer $\\hat{y}' = a \\cdot \\hat{y} + b$ on top of any base model's predictions.\n",
    "Three variants are supported:\n",
    "- **`cl`**: Optimize only $\\mathcal{L}_{con}$\n",
    "- **`rmse_cl`**: Optimize $w_{rmse} \\cdot \\text{RMSE}_{norm} + w_{cl} \\cdot \\text{CL}_{norm}$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "@dataclass\n",
    "class CalibResult:\n",
    "    a: float\n",
    "    b: float\n",
    "    logs: Dict[str, list]\n",
    "\n",
    "@dataclass\n",
    "class FitArtifacts:\n",
    "    y_true: np.ndarray\n",
    "    y_pred: np.ndarray\n",
    "    tail_q05: float\n",
    "    tail_q95: float\n",
    "    diag_test: Optional[np.ndarray] = None\n",
    "    diag_name: Optional[str] = None\n",
    "    extra: Optional[dict] = None\n",
    "\n",
    "def train_affine_calibrator(yhat_base, y_true, T, mode='cl',\n",
    "                             rmse_weight=.6, cl_weight=.4,\n",
    "                             epochs=CL_EPOCHS, batch_size=CL_BATCH_SIZE,\n",
    "                             lr=CL_LR, seed=SEED,\n",
    "                             rmse0=None, cl0=None):\n",
    "    \"\"\"\n",
    "    Train affine calibration layer y' = a*yhat + b.\n",
    "    \n",
    "    Uses Adam optimizer with subsampling to avoid O(n^2) contrastive loss.\n",
    "    \"\"\"\n",
    "    t_start = time.time()\n",
    "    rng = np.random.default_rng(seed)\n",
    "    yhat_base = np.asarray(yhat_base, dtype=float)\n",
    "    y_true = np.asarray(y_true, dtype=float)\n",
    "    n = len(y_true)\n",
    "    if n == 0:\n",
    "        return CalibResult(a=1., b=0., logs={'loss':[], 'rmse':[], 'cl':[]})\n",
    "    \n",
    "    # Subsampling helpers\n",
    "    CL0_MAX_N, CL0_BATCH, CL_EVAL_MAX_N = 3000, 512, 3000\n",
    "    \n",
    "    def _subsample(x, y, max_n):\n",
    "        if len(y) <= max_n: return x, y\n",
    "        idx = rng.choice(len(y), size=max_n, replace=False)\n",
    "        return x[idx], y[idx]\n",
    "    \n",
    "    def _estimate_cl(x, y, T, bs):\n",
    "        n_local = len(y)\n",
    "        if n_local == 0: return 0.\n",
    "        perm = rng.permutation(n_local)\n",
    "        vals = [cl_loss_and_p(x[perm[s:s+bs]], y[perm[s:s+bs]], T)[0]\n",
    "                for s in range(0, n_local, bs)]\n",
    "        return float(np.mean(vals)) if vals else 0.\n",
    "    \n",
    "    # Init params\n",
    "    a, b = 1., 0.\n",
    "    \n",
    "    # RMSE norm\n",
    "    if rmse0 is None:\n",
    "        rmse0, _ = rmse_grad(a*yhat_base + b, y_true)\n",
    "    rmse0 = float(max(float(rmse0), 1e-6))\n",
    "    \n",
    "    # CL norm (subsampled)\n",
    "    if cl0 is None:\n",
    "        xb0, yb0 = _subsample(yhat_base, y_true, CL0_MAX_N)\n",
    "        cl0 = _estimate_cl(a*xb0+b, yb0, T, CL0_BATCH)\n",
    "    cl0 = float(max(float(cl0), 1e-6))\n",
    "    \n",
    "    print(f'[calib] mode={mode} n={n} epochs={epochs} | '\n",
    "          f'rmse0={rmse0:.6f} cl0~{cl0:.6f}', flush=True)\n",
    "    \n",
    "    # Adam\n",
    "    ma, va, mb, vb = 0., 0., 0., 0.\n",
    "    b1, b2, ad_eps = .9, .999, 1e-8\n",
    "    logs = {'loss':[], 'rmse':[], 'cl':[]}\n",
    "    step = 0\n",
    "    \n",
    "    for ep in range(epochs):\n",
    "        idx = rng.permutation(n)\n",
    "        for start in range(0, n, batch_size):\n",
    "            step += 1\n",
    "            batch = idx[start:start+batch_size]\n",
    "            yb, xb = y_true[batch], yhat_base[batch]\n",
    "            yhat = a*xb + b\n",
    "            \n",
    "            rmse, gr = rmse_grad(yhat, yb)\n",
    "            cl, _ = cl_loss_and_p(yhat, yb, T)\n",
    "            gc = cl_grad(yhat, yb, T)\n",
    "            \n",
    "            if mode == 'cl':\n",
    "                loss, gy = cl, gc\n",
    "            elif mode == 'rmse_cl':\n",
    "                loss = rmse_weight*(rmse/rmse0) + cl_weight*(cl/cl0)\n",
    "                gy = rmse_weight*(gr/rmse0) + cl_weight*(gc/cl0)\n",
    "            else:\n",
    "                raise ValueError(f'Unknown mode: {mode}')\n",
    "            \n",
    "            ga, gb = float(np.sum(gy*xb)), float(np.sum(gy))\n",
    "            ma = b1*ma + (1-b1)*ga\n",
    "            va = b2*va + (1-b2)*ga*ga\n",
    "            mb = b1*mb + (1-b1)*gb\n",
    "            vb = b2*vb + (1-b2)*gb*gb\n",
    "            a -= lr*(ma/(1-b1**step))/(np.sqrt(va/(1-b2**step))+ad_eps)\n",
    "            b -= lr*(mb/(1-b1**step))/(np.sqrt(vb/(1-b2**step))+ad_eps)\n",
    "        \n",
    "        # Epoch logging\n",
    "        yhat_f = a*yhat_base + b\n",
    "        rmse_f, _ = rmse_grad(yhat_f, y_true)\n",
    "        xbe, ybe = _subsample(yhat_f, y_true, CL_EVAL_MAX_N)\n",
    "        cl_f = _estimate_cl(xbe, ybe, T, CL0_BATCH)\n",
    "        lf = (rmse_weight*(rmse_f/rmse0)+cl_weight*(cl_f/cl0)) if mode=='rmse_cl' else cl_f\n",
    "        logs['loss'].append(float(lf))\n",
    "        logs['rmse'].append(float(rmse_f))\n",
    "        logs['cl'].append(float(cl_f))\n",
    "        print(f'[calib] ep={ep+1}/{epochs} loss={lf:.6f} '\n",
    "              f'rmse={rmse_f:.6f} cl={cl_f:.6f} a={a:.5f} b={b:.5f}', flush=True)\n",
    "    \n",
    "    logs['rmse0'], logs['cl0'] = float(rmse0), float(cl0)\n",
    "    return CalibResult(a=float(a), b=float(b), logs=logs)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 5: Baseline Models\n",
    "\n",
    "Defines all baseline models with their hyperparameters and a unified builder."
   ]
  },
