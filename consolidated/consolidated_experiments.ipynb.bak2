   "source": [
    "## Section 6: Contrastive Learning Experiments\n",
    "\n",
    "### 6a: XGBoost with Custom Contrastive Objective\n",
    "\n",
    "Uses XGBoost's custom objective API to directly optimize a contrastive loss during training."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================================\n",
    "# §6a  XGBoost WITH CONTRASTIVE OBJECTIVE\n",
    "# =====================================================================\n",
    "\n",
    "class XGBContrastiveLossObjective:\n",
    "    \"\"\"\n",
    "    Custom XGBoost objective combining RMSE and Contrastive Loss.\n",
    "    \n",
    "    Parameters\n",
    "    ----------\n",
    "    lam : float\n",
    "        Weight for contrastive loss component (CL_weight)\n",
    "    alpha : float\n",
    "        Weight for RMSE component = 1 - lam\n",
    "    T : float\n",
    "        Temperature for contrastive loss\n",
    "    \"\"\"\n",
    "    def __init__(self, lam: float, alpha: float, T: float):\n",
    "        self.lam = lam\n",
    "        self.alpha = alpha\n",
    "        self.T = T\n",
    "    \n",
    "    def __call__(self, labels, preds):\n",
    "        y_true = labels.astype(np.float64)\n",
    "        y_pred = preds.astype(np.float64)\n",
    "        \n",
    "        if len(y_true) == 0:\n",
    "            grad = np.zeros_like(preds)\n",
    "            hess = np.ones_like(preds)\n",
    "            return grad, hess\n",
    "        \n",
    "        # RMSE gradient\n",
    "        err = y_pred - y_true\n",
    "        mse = np.mean(err**2)\n",
    "        rmse = np.sqrt(max(mse, 1e-8))\n",
    "        grad_rmse = err / (rmse * len(y_true)) if rmse > 1e-8 else np.zeros_like(err)\n",
    "        \n",
    "        # CL gradient\n",
    "        T = max(self.T, 1e-8)\n",
    "        D = np.abs(y_pred[:, None] - y_true[None, :])\n",
    "        logits = -D / T\n",
    "        logits -= np.max(logits, axis=1, keepdims=True)\n",
    "        P = np.exp(logits) / np.maximum(\n",
    "            np.sum(np.exp(logits), axis=1, keepdims=True), 1e-12)\n",
    "        S = np.sign(y_pred[:, None] - y_true[None, :])\n",
    "        grad_cl = (np.diag(S) - np.sum(P * S, axis=1)) / T / len(y_true)\n",
    "        \n",
    "        # Combined gradient (first order)\n",
    "        grad = self.alpha * grad_rmse + self.lam * grad_cl\n",
    "        \n",
    "        # Hessian: constant for simplicity (matches XGB docs for custom obj)\n",
    "        hess = np.full_like(preds, 1.0 / max(rmse, 1e-8))\n",
    "        \n",
    "        return grad, hess\n",
    "\n",
    "\n",
    "def run_xgb_contrastive_experiment(split_name, target):\n",
    "    \"\"\"\n",
    "    Compare XGBoost with standard RMSE vs XGBoost with CL objective.\n",
    "    Uses the original XGBoost hyperparameters (600 trees, etc.).\n",
    "    \"\"\"\n",
    "    print(f'\\n=== XGB Contrastive Experiment [{split_name}, {target}] ===')\n",
    "    \n",
    "    if split_name == 'Random(70/15/15)':\n",
    "        tr, va, te = make_random_split(df)\n",
    "    else:\n",
    "        tr, va, te = make_group_split_by_grid(df)\n",
    "    \n",
    "    tr = filter_missing(df, tr, target)\n",
    "    te = filter_missing(df, te, target)\n",
    "    \n",
    "    # Use preprocessor to one-hot encode categorical features\n",
    "    X_tr_raw = df.iloc[tr][FEATURE_COLS]\n",
    "    y_tr = df.iloc[tr][target].astype(float).values\n",
    "    X_te_raw = df.iloc[te][FEATURE_COLS]\n",
    "    y_te = df.iloc[te][target].astype(float).values\n",
    "    \n",
    "    pre = build_preprocessor()\n",
    "    X_tr = pre.fit_transform(X_tr_raw)\n",
    "    X_te = pre.transform(X_te_raw)\n",
    "    \n",
    "    q05, q95 = tail_thresholds(y_tr)\n",
    "    T_temp = compute_temp(y_tr)\n",
    "    \n",
    "    results = []\n",
    "    \n",
    "    # --- XGBoost Baseline ---\n",
    "    xgb_base = XGBRegressor(objective='reg:squarederror',\n",
    "                             n_estimators=600, learning_rate=.05,\n",
    "                             max_depth=6, subsample=.8,\n",
    "                             colsample_bytree=.8, random_state=SEED,\n",
    "                             n_jobs=-1, verbosity=0)\n",
    "    xgb_base.fit(X_tr, y_tr)\n",
    "    yhat_te = xgb_base.predict(X_te)\n",
    "    m = eval_tail(y_te, yhat_te, q05, q95)\n",
    "    results.append({'Model': 'XGBoost', **m})\n",
    "    \n",
    "    # --- XGBoost + CL Objective ---\n",
    "    cl_obj = XGBContrastiveLossObjective(lam=.3, alpha=.7, T=T_temp)\n",
    "    xgb_cl = XGBRegressor(objective=cl_obj,\n",
    "                           n_estimators=600, learning_rate=.05,\n",
    "                           max_depth=6, subsample=.8,\n",
    "                           colsample_bytree=.8, random_state=SEED,\n",
    "                           n_jobs=-1, verbosity=0)\n",
    "    xgb_cl.fit(X_tr, y_tr)\n",
    "    yhat_te_cl = xgb_cl.predict(X_te)\n",
    "    m = eval_tail(y_te, yhat_te_cl, q05, q95)\n",
    "    results.append({'Model': 'XGBoost_CL', **m})\n",
    "    \n",
    "    # --- XGBoost + CL Objective + Affine Calibrator ---\n",
    "    yhat_tr_cl = xgb_cl.predict(X_tr)\n",
    "    calib = train_affine_calibrator(yhat_tr_cl, y_tr, T_temp, mode='cl')\n",
    "    yhat_te_cal = calib.a * yhat_te_cl + calib.b\n",
    "    m = eval_tail(y_te, yhat_te_cal, q05, q95)\n",
    "    results.append({'Model': 'XGBoost_CL+Calib', **m})\n",
    "    \n",
    "    for r in results:\n",
    "        r['Split'] = split_name\n",
    "        r['Target'] = target\n",
    "    \n",
    "    return pd.DataFrame(results)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 6b: RandomForest with Contrastive Learning Calibration\n",
    "\n",
    "Uses the affine calibrator on top of a base RF model."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================================\n",
    "# §6b  RANDOMFOREST + CONTRASTIVE CALIBRATION\n",
    "# =====================================================================\n",
    "\n",
    "def run_rf_contrastive_experiment(split_name, target):\n",
    "    \"\"\"\n",
    "    Compare RandomForest baseline vs RF + CL calibrator.\n",
    "    \"\"\"\n",
    "    print(f'\\n=== RF Contrastive Experiment [{split_name}, {target}] ===')\n",
    "    \n",
    "    if split_name == 'Random(70/15/15)':\n",
    "        tr, va, te = make_random_split(df)\n",
    "    else:\n",
    "        tr, va, te = make_group_split_by_grid(df)\n",
    "    \n",
    "    tr = filter_missing(df, tr, target)\n",
    "    va = filter_missing(df, va, target)\n",
    "    te = filter_missing(df, te, target)\n",
    "    \n",
    "    # Use preprocessor to one-hot encode categorical features\n",
    "    X_tr_raw = df.iloc[tr][FEATURE_COLS]\n",
    "    y_tr = df.iloc[tr][target].astype(float).values\n",
    "    X_va_raw = df.iloc[va][FEATURE_COLS]\n",
    "    y_va = df.iloc[va][target].astype(float).values\n",
    "    X_te_raw = df.iloc[te][FEATURE_COLS]\n",
    "    y_te = df.iloc[te][target].astype(float).values\n",
    "    \n",
    "    pre = build_preprocessor()\n",
    "    X_tr = pre.fit_transform(X_tr_raw)\n",
    "    X_va = pre.transform(X_va_raw)\n",
    "    X_te = pre.transform(X_te_raw)\n",
    "    \n",
    "    q05, q95 = tail_thresholds(y_tr)\n",
    "    T_temp = compute_temp(y_tr)\n",
    "    \n",
    "    # Base RF\n",
    "    rf = RandomForestRegressor(n_estimators=150, random_state=SEED, n_jobs=-1)\n",
    "    rf.fit(X_tr, y_tr)\n",
    "    yhat_te = rf.predict(X_te)\n",
    "    yhat_tr = rf.predict(X_tr)\n",
    "    \n",
    "    results = []\n",
    "    m = eval_tail(y_te, yhat_te, q05, q95)\n",
    "    results.append({'Model': 'RF', **m})\n",
    "    \n",
    "    # RF + CL calibrator\n",
    "    calib = train_affine_calibrator(yhat_tr, y_tr, T_temp, mode='cl')\n",
    "    yhat_te_cal = calib.a * yhat_te + calib.b\n",
    "    m = eval_tail(y_te, yhat_te_cal, q05, q95)\n",
    "    results.append({'Model': 'RF_CL', **m})\n",
    "    \n",
    "    # RF + RMSE_CL calibrator\n",
    "    calib2 = train_affine_calibrator(yhat_tr, y_tr, T_temp,\n",
    "                                     mode='rmse_cl', rmse_weight=.6, cl_weight=.4)\n",
    "    yhat_te_mix = calib2.a * yhat_te + calib2.b\n",
    "    m = eval_tail(y_te, yhat_te_mix, q05, q95)\n",
    "    results.append({'Model': 'RF_RMSE_CL', **m})\n",
    "    \n",
    "    for r in results:\n",
    "        r['Split'] = split_name\n",
    "        r['Target'] = target\n",
    "    return pd.DataFrame(results)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 7: Mixture of Experts (MoE)\n",
    "\n",
    "A two-expert MoE with:\n",
    "- **Body expert**: handles non-extreme samples\n",
    "- **Tail expert**: handles extreme samples\n",
    "- **Gate**: learnable gating network that weights the two experts\n",
    "\n",
    "The target is transformed using `signedlog1p` to handle skewness."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================================\n",
    "# §7  MIXTURE OF EXPERTS (MoE)\n",
    "# =====================================================================\n",
    "\n",
    "def signed_log1p(x):\n",
    "    \"\"\"Signed log(1 + x) transformation, preserving sign.\"\"\"\n",
    "    return np.sign(x) * np.log1p(np.abs(x))\n",
    "\n",
    "def signed_expm1(x):\n",
    "    \"\"\"Inverse of signed_log1p.\"\"\"\n",
    "    return np.sign(x) * np.expm1(np.abs(x))\n",
    "\n",
    "\n",
    "def fit_moe_model(X_tr, y_tr, X_va, y_va, X_te, y_te, seed=SEED):\n",
    "    \"\"\"\n",
    "    Fit a two-expert Mixture of Experts model.\n",
    "    \n",
    "    The gate uses a RF classifier to predict which expert (body/tail) to trust.\n",
    "    The tail expert also applies signed_log1p transformation and inverse.\n",
    "    \"\"\"\n",
    "    from sklearn.ensemble import RandomForestClassifier\n",
    "    \n",
    "    rng = np.random.RandomState(seed)\n",
    "    \n",
    "    # --- Step 1: Train body expert (RF on all data) ---\n",
    "    body_expert = RandomForestRegressor(\n",
    "        n_estimators=150, random_state=seed, n_jobs=-1)\n",
    "    body_expert.fit(X_tr, y_tr)\n",
    "    yhat_body_tr = body_expert.predict(X_tr)\n",
    "    \n",
    "    # --- Step 2: Identify tail samples from body residuals ---\n",
    "    residuals_tr = np.abs(y_tr - yhat_body_tr)\n",
    "    tail_threshold = np.quantile(residuals_tr, 0.8)  # Top 20% residual = tail\n",
    "    tail_mask_tr = residuals_tr >= tail_threshold\n",
    "    \n",
    "    # --- Step 3: Train tail expert on tail samples (with signed_log1p) ---\n",
    "    if tail_mask_tr.sum() > 10:\n",
    "        X_tail_tr = X_tr.iloc[tail_mask_tr]\n",
    "        y_tail_tr = signed_log1p(y_tr[tail_mask_tr])\n",
    "        tail_expert = RandomForestRegressor(\n",
    "            n_estimators=100, random_state=seed, n_jobs=-1)\n",
    "        tail_expert.fit(X_tail_tr, y_tail_tr)\n",
    "    else:\n",
    "        tail_expert = None\n",
    "    \n",
    "    # --- Step 4: Train gate (classifier: body vs tail) ---\n",
    "    gate_labels = tail_mask_tr.astype(int)\n",
    "    gate = RandomForestClassifier(\n",
    "        n_estimators=100, random_state=seed, n_jobs=-1)\n",
    "    gate.fit(X_tr, gate_labels)\n",
    "    \n",
    "    # --- Step 5: Predict on test ---\n",
    "    yhat_body_te = body_expert.predict(X_te)\n",
    "    \n",
    "    if tail_expert is not None:\n",
    "        yhat_tail_te = signed_expm1(tail_expert.predict(X_te))\n",
    "    else:\n",
    "        yhat_tail_te = yhat_body_te\n",
    "    \n",
    "    gate_probs = gate.predict_proba(X_te)\n",
    "    # Probability of being tail (class 1)\n",
    "    gate_tail_prob = gate_probs[:, 1] if gate_probs.shape[1] > 1 else np.zeros(len(X_te))\n",
    "    \n",
    "    # Weighted combination\n",
    "    yhat_moe = (1 - gate_tail_prob) * yhat_body_te + gate_tail_prob * yhat_tail_te\n",
    "    \n",
    "    return {\n",
    "        'body_expert': body_expert,\n",
    "        'tail_expert': tail_expert,\n",
    "        'gate': gate,\n",
    "        'yhat_body': yhat_body_te,\n",
    "        'yhat_tail': yhat_tail_te,\n",
    "        'yhat_moe': yhat_moe,\n",
    "        'gate_tail_prob': gate_tail_prob,\n",
    "    }\n",
    "\n",
    "\n",
    "def run_moe_experiment(split_name, target):\n",
    "    \"\"\"Run the full MoE experiment for a given split and target.\"\"\"\n",
    "    print(f'\\n=== MoE Experiment [{split_name}, {target}] ===')\n",
    "    \n",
    "    if split_name == 'Random(70/15/15)':\n",
    "        tr, va, te = make_random_split(df)\n",
    "    else:\n",
    "        tr, va, te = make_group_split_by_grid(df)\n",
    "    \n",
    "    tr = filter_missing(df, tr, target)\n",
    "    va = filter_missing(df, va, target)\n",
    "    te = filter_missing(df, te, target)\n",
    "    \n",
    "    # Use preprocessor to one-hot encode categorical features\n",
    "    X_tr_raw = df.iloc[tr][FEATURE_COLS]\n",
    "    y_tr = df.iloc[tr][target].astype(float).values\n",
    "    X_va_raw = df.iloc[va][FEATURE_COLS]\n",
    "    y_va = df.iloc[va][target].astype(float).values\n",
    "    X_te_raw = df.iloc[te][FEATURE_COLS]\n",
    "    y_te = df.iloc[te][target].astype(float).values\n",
    "    \n",
    "    pre = build_preprocessor()\n",
    "    X_tr = pre.fit_transform(X_tr_raw)\n",
    "    X_va = pre.transform(X_va_raw)\n",
    "    X_te = pre.transform(X_te_raw)\n",
    "    \n",
    "    q05, q95 = tail_thresholds(y_tr)\n",
    "    \n",
    "    # Baseline RF\n",
    "    rf_base = RandomForestRegressor(n_estimators=150, random_state=SEED, n_jobs=-1)\n",
    "    rf_base.fit(X_tr, y_tr)\n",
    "    yhat_rf = rf_base.predict(X_te)\n",
    "    \n",
    "    # MoE\n",
    "    moe_out = fit_moe_model(X_tr, y_tr, X_va, y_va, X_te, y_te)\n",
    "    \n",
    "    results = []\n",
    "    m = eval_tail(y_te, yhat_rf, q05, q95)\n",
    "    results.append({'Model': 'RF_Baseline', **m})\n",
    "    \n",
    "    m = eval_tail(y_te, moe_out['yhat_body'], q05, q95)\n",
    "    results.append({'Model': 'MoE_Body', **m})\n",
    "    \n",
    "    m = eval_tail(y_te, moe_out['yhat_tail'], q05, q95)\n",
    "    results.append({'Model': 'MoE_Tail', **m})\n",
    "    \n",
    "    m = eval_tail(y_te, moe_out['yhat_moe'], q05, q95)\n",
    "    results.append({'Model': 'MoE_Combined', **m})\n",
    "    \n",
    "    for r in results:\n",
    "        r['Split'] = split_name\n",
    "        r['Target'] = target\n",
    "    \n",
    "    return pd.DataFrame(results), moe_out"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 8: Multi-Baselines with Affine Calibration\n",
    "\n",
    "For each baseline model, three variants are trained:\n",
    "1. **Base**: Standard RMSE/MSE training\n",
    "2. **CL**: Affine calibrator trained with only contrastive loss\n",
    "3. **RMSE_CL**: Affine calibrator trained with mixed RMSE + CL loss\n",
    "\n",
    "This runs for 7 baselines × 2 splits × 2 targets = 28 model combinations."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================================\n",
    "# §8  MULTI-BASELINES WITH AFFINE CALIBRATION\n",
    "# =====================================================================\n",
    "\n",
    "def fit_one_model_three_variants(df_in, train_idx, val_idx, test_idx,\n",
    "                                 target, baseline_name,\n",
    "                                 rmse_weight=.6, cl_weight=.4):\n",
    "    \"\"\"\n",
    "    Train one baseline model and produce 3 variants:\n",
    "      - Baseline (base RMSE)\n",
    "      - Baseline_CL (contrastive calibrator only)\n",
    "      - Baseline_RMSE_CL (mixed calibrator)\n",
    "    \n",
    "    Returns (list_of_result_rows, dict_of_artifacts).\n",
    "    \"\"\"\n",
    "    tr = filter_missing(df_in, train_idx, target)\n",
    "    va = filter_missing(df_in, val_idx, target)\n",
    "    te = filter_missing(df_in, test_idx, target)\n",
    "    \n",
    "    X_tr = df_in.iloc[tr][FEATURE_COLS]\n",
    "    y_tr = df_in.iloc[tr][target].astype(float).values\n",
    "    X_va = df_in.iloc[va][FEATURE_COLS]\n",
    "    y_va = df_in.iloc[va][target].astype(float).values\n",
    "    X_te = df_in.iloc[te][FEATURE_COLS]\n",
    "    y_te = df_in.iloc[te][target].astype(float).values\n",
    "    \n",
    "    q05, q95 = tail_thresholds(y_tr)\n",
    "    \n",
    "    # Fit baseline\n",
    "    pipe = build_pipeline(baseline_name)\n",
    "    t0 = time.time()\n",
    "    print(f'Fitting {baseline_name} on {target} | n_tr={len(y_tr)}')\n",
    "    pipe.fit(X_tr, y_tr)\n",
    "    dt = time.time() - t0\n",
    "    print(f'Done {baseline_name} in {dt:.1f}s')\n",
    "    \n",
    "    yhat_tr = pipe.predict(X_tr)\n",
    "    yhat_te = pipe.predict(X_te)\n",
    "    T_temp = compute_temp(y_tr)\n",
    "    \n",
    "    rows = []\n",
    "    arts = {}\n",
    "    \n",
    "    # Variant A: Baseline\n",
    "    m = eval_tail(y_te, yhat_te, q05, q95)\n",
    "    rows.append({'Target': target, 'Model': baseline_name, **m})\n",
    "    arts[baseline_name] = FitArtifacts(y_te, yhat_te, q05, q95)\n",
    "    \n",
    "    # Variant B: Baseline_CL\n",
    "    calib_cl = train_affine_calibrator(yhat_tr, y_tr, T_temp, mode='cl')\n",
    "    yhat_te_cl = calib_cl.a * yhat_te + calib_cl.b\n",
    "    m = eval_tail(y_te, yhat_te_cl, q05, q95)\n",
    "    name_cl = f'{baseline_name}_CL'\n",
    "    rows.append({'Target': target, 'Model': name_cl, **m})\n",
    "    arts[name_cl] = FitArtifacts(y_te, yhat_te_cl, q05, q95,\n",
    "                                  diag_test=approx_pi(yhat_te_cl, y_te, T_temp),\n",
    "                                  diag_name='p_i',\n",
    "                                  extra={'T': T_temp, 'calib': calib_cl})\n",
    "    \n",
    "    # Variant C: Baseline_RMSE_CL\n",
    "    calib_mix = train_affine_calibrator(yhat_tr, y_tr, T_temp,\n",
    "                                        mode='rmse_cl',\n",
    "                                        rmse_weight=rmse_weight,\n",
    "                                        cl_weight=cl_weight)\n",
    "    yhat_te_mix = calib_mix.a * yhat_te + calib_mix.b\n",
    "    m = eval_tail(y_te, yhat_te_mix, q05, q95)\n",
    "    name_mix = f'{baseline_name}_RMSE_CL'\n",
    "    rows.append({'Target': target, 'Model': name_mix, **m})\n",
    "    arts[name_mix] = FitArtifacts(y_te, yhat_te_mix, q05, q95,\n",
    "                                   diag_test=approx_pi(yhat_te_mix, y_te, T_temp),\n",
    "                                   diag_name='p_i',\n",
    "                                   extra={'T': T_temp, 'calib': calib_mix})\n",
    "    \n",
    "    return rows, arts\n",
    "\n",
    "\n",
    "def run_all_multibaselines(df_in, train_idx, val_idx, test_idx, target,\n",
    "                            model_names=None, rmse_weight=.6, cl_weight=.4):\n",
    "    \"\"\"Run all baseline models for a given split and target.\"\"\"\n",
    "    if model_names is None:\n",
    "        model_names = BASELINE_NAMES\n",
    "    \n",
    "    all_rows = []\n",
    "    all_arts = {}\n",
    "    \n",
    "    for i, bname in enumerate(model_names, 1):\n",
    "        print(f'\\n--- [{i}/{len(model_names)}] {bname} ---')\n",
    "        rows, arts = fit_one_model_three_variants(\n",
    "            df_in, train_idx, val_idx, test_idx, target, bname,\n",
    "            rmse_weight=rmse_weight, cl_weight=cl_weight)\n",
    "        all_rows.extend(rows)\n",
    "        all_arts.update(arts)\n",
    "    \n",
    "    return all_rows, all_arts"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 9: Mix-Weight Sweep\n",
    "\n",
    "Sweeps the RMSE weight $w_{rmse} \\in [0, 1]$ (with CL weight $= 1 - w_{rmse}$)\n",
    "for the mixed calibrator and observes the effect on All and Tail metrics.\n",
    "\n",
    "The baseline is fitted **once**, then the affine calibrator is re-trained for each weight value."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================================\n",
    "# §9  MIX-WEIGHT SWEEP\n",
    "# =====================================================================\n",
    "\n",
    "def run_weight_sweep(split_name, target, weights=None,\n",
    "                      model_names=None, verbose=True):\n",
    "    \"\"\"\n",
    "    Sweep over mix-weights for the affine calibrator.\n",
    "    \n",
    "    The baseline is fitted ONCE per model; results are cached.\n",
    "    \n",
    "    Parameters\n",
    "    ----------\n",
    "    split_name : str\n",
    "    target : str\n",
    "    weights : array-like\n",
    "        RMSE weight values to sweep\n",
    "    model_names : list\n",
    "        Models to include\n",
    "    \n",
    "    Returns (df_raw, df_agg)\n",
    "    \"\"\"\n",
    "    if weights is None:\n",
    "        weights = np.arange(0., 1.01, .05)\n",
    "    if model_names is None:\n",
    "        model_names = NOXGB_NAMES\n",
    "    \n",
    "    if split_name == 'Random(70/15/15)':\n",
    "        tr, va, te = make_random_split(df)\n",
    "    else:\n",
    "        tr, va, te = make_group_split_by_grid(df)\n",
    "    \n",
    "    rows = []\n",
    "    \n",
    "    for mi, mname in enumerate(model_names, 1):\n",
    "        if verbose:\n",
    "            print(f'[{mi}/{len(model_names)}] {mname}: fitting...', end=' ', flush=True)\n",
    "        \n",
    "        tr_f = filter_missing(df, tr, target)\n",
    "        te_f = filter_missing(df, te, target)\n",
    "        \n",
    "        X_tr = df.iloc[tr_f][FEATURE_COLS]\n",
    "        y_tr = df.iloc[tr_f][target].to_numpy(dtype=float)\n",
    "        X_te = df.iloc[te_f][FEATURE_COLS]\n",
    "        y_te = df.iloc[te_f][target].to_numpy(dtype=float)\n",
    "        \n",
    "        q05, q95 = tail_thresholds(y_tr)\n",
    "        T_temp = compute_temp(y_tr)\n",
    "        \n",
    "        # Fit baseline once\n",
    "        pipe = build_pipeline(mname)\n",
    "        pipe.fit(X_tr, y_tr)\n",
    "        yhat_tr = pipe.predict(X_tr).astype(float)\n",
    "        yhat_te = pipe.predict(X_te).astype(float)\n",
    "        \n",
    "        if verbose:\n",
    "            print('calibrating...', end=' ', flush=True)\n",
    "        \n",
    "        # Warm up: compute rmse0, cl0 once\n",
    "        warm = train_affine_calibrator(yhat_tr, y_tr, T_temp,\n",
    "                                       mode='rmse_cl',\n",
    "                                       epochs=1, lr=CL_LR,\n",
    "                                       batch_size=CL_BATCH_SIZE,\n",
    "                                       rmse0=None, cl0=None)\n",
    "        rmse0 = float(warm.logs.get('rmse0', np.nan))\n",
    "        cl0 = float(warm.logs.get('cl0', np.nan))\n",
    "        \n",
    "        if verbose:\n",
    "            print(f'sweeping {len(weights)} weights', flush=True)\n",
    "        \n",
    "        # Sweep weights\n",
    "        for w in weights:\n",
    "            w = float(w)\n",
    "            calib = train_affine_calibrator(\n",
    "                yhat_tr, y_tr, T_temp, mode='rmse_cl',\n",
    "                rmse_weight=w, cl_weight=1.-w,\n",
    "                epochs=CL_EPOCHS, lr=CL_LR,\n",
    "                batch_size=CL_BATCH_SIZE,\n",
    "                rmse0=rmse0, cl0=cl0)\n",
    "            \n",
    "            yhat_cal = calib.a * yhat_te + calib.b\n",
    "            m = eval_tail(y_te, yhat_cal, q05, q95)\n",
    "            \n",
    "            rows.append({\n",
    "                'split': split_name,\n",
    "                'target': target,\n",
    "                'model': mname,\n",
    "                'w_rmse': w,\n",
    "                'w_cl': 1.-w,\n",
    "                'R2_all': m['All_R2'],\n",
    "                'RMSE_all': m['All_RMSE'],\n",
    "                'R2_tail': m['Tail_R2'],\n",
    "                'RMSE_tail': m['Tail_RMSE'],\n",
    "            })\n",
    "    \n",
    "    df_raw = pd.DataFrame(rows)\n",
    "    \n",
    "    # Aggregate across models\n",
    "    df_agg = (df_raw.groupby(['split', 'target', 'w_rmse'], as_index=False)\n",
    "              .agg({k: ['mean', 'std'] for k in \n",
    "                    ['R2_all', 'R2_tail', 'RMSE_all', 'RMSE_tail']}))\n",
    "    df_agg.columns = ['_'.join(c).strip('_') for c in df_agg.columns]\n",
    "    df_agg = df_agg.sort_values('w_rmse').reset_index(drop=True)\n",
    "    \n",
    "    return df_raw, df_agg"
   ]
  },
  {
