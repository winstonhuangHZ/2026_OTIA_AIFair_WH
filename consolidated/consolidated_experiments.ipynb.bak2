    "# =====================================================================\n",
    "# §13  GENERATE FIGURES\n",
    "# =====================================================================\n",
    "\n",
    "print(f'Output directory for figures: {FIGDIR}')\n",
    "\n",
    "# 1) Triplet figures for multi-baselines\n",
    "for key, arts in all_artifacts.items():\n",
    "    if not key.startswith('MB_'):\n",
    "        continue\n",
    "    # key is 'MB_{split}_{target}'\n",
    "    parts = key.split('_')\n",
    "    split_name = parts[1]\n",
    "    target = parts[2]\n",
    "    \n",
    "    for base_name in ['Ridge', 'ElasticNet', 'SVR', 'RandomForest',\n",
    "                      'ExtraTrees', 'MLP', 'XGBoost']:\n",
    "        # Only plot if artifacts exist\n",
    "        if all(k in arts for k in [base_name, f'{base_name}_CL', f'{base_name}_RMSE_CL']):\n",
    "            fig = plot_triplet(arts, base_name, split_name, target)\n",
    "            save_fig(fig, f'triplet_{split_name}_{target}_{base_name}.png')\n",
    "            print(f'Saved triplet: {base_name}')\n",
    "            \n",
    "        # p_i diagnostics\n",
    "        for suffix in ['_CL', '_RMSE_CL']:\n",
    "            k = f'{base_name}{suffix}'\n",
    "            if k in arts and arts[k].diag_test is not None:\n",
    "                fig = plot_pi_diag(arts[k], f'[{split_name}] {k} - {target}')\n",
    "                if fig:\n",
    "                    save_fig(fig, f'pi_{split_name}_{target}_{k}.png')\n",
    "\n",
    "# 2) Weight sweep figures\n",
    "if df_sweep_agg is not None:\n",
    "    for metric in ['R2', 'RMSE']:\n",
    "        fig = plot_weight_sweep(df_sweep_agg, metric, sweep_split, sweep_target)\n",
    "        save_fig(fig, f'sweep_{metric}__{sweep_split}__{sweep_target}.png')\n",
    "        print(f'Saved sweep {metric} figure')\n",
    "    \n",
    "    # Per-model compound figure\n",
    "    fig = plot_per_model_sweep(df_sweep_raw, sweep_split, sweep_target)\n",
    "    save_fig(fig, f'sweep_per_model__{sweep_split}__{sweep_target}.png')\n",
    "    print('Saved per-model sweep figure')\n",
    "\n",
    "print(f'\\nAll figures saved to {FIGDIR}')"
   ]
  },
